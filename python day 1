#include <stdio.h>
#include <math.h>
int main(void){
    intn; if(scanf("%d", &n) != 1) return 1;
    for(int i=3; i<=n; i++){
        int prime =1;
        for(int j=3; j*j<=i;j++){ 
            if(i%j==0){
                prime =0;
                break;
            }
            if(prime) printf("%d\n", i);
        }
        return 0;
    }

            
        
    


}